{
  "manifest_version": 3,
  "name": "Fiesta Verkäufer",
  "version": "1.0.0",
  "description": "Erstellt das Ford-Fiesta-Inserat automatisch auf AutoScout24.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.autoscout24.de/*", "https://autoscout24.de/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Fiesta Verkäufer",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/car-16.png", "32": "icons/car-32.png", "48": "icons/car-48.png", "128": "icons/car-128.png"}
  },
  "icons": {"16": "icons/car-16.png", "32": "icons/car-32.png", "48": "icons/car-48.png", "128": "icons/car-128.png"},
  "content_scripts": [{
    "matches": ["https://www.autoscout24.de/*", "https://autoscout24.de/*"],
    "js": ["profile.js", "automation.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["Bilder/*.jpg"],
    "matches": ["https://www.autoscout24.de/*", "https://autoscout24.de/*"]
  }]
}
